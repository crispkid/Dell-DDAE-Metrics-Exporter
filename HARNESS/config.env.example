# Copy this file to HARNESS/config.env and commit the completed project policy.
# This trusted Bash fragment is executable repository code, not a dotenv file.
# Never store secrets, private endpoints, production data, or personal data here.
# Policy assignments are intentionally direct: ordinary caller/CI environments
# must not silently change the deterministic gate. Pass runtime inputs and
# secrets through project-owned variables consumed by configured scripts.

HARNESS_PROJECT_NAME=''
HARNESS_REQUIRED_PATHS=''
HARNESS_EXPECTED_BASELINE_VERSION='1.0.0'

# Strict SDD is the default for adopted projects. `off` is an explicit
# exception and requires a filled reason, accountable owner, and follow-up in
# PROJECT.md.
HARNESS_SDD_MODE='required'

# Instruction discovery. Paths are colon-separated.
HARNESS_INSTRUCTION_MAX_BYTES='32768'
HARNESS_INSTRUCTION_FALLBACK_FILENAMES=''
HARNESS_INSTRUCTION_TARGETS='.'
HARNESS_INSTRUCTION_REFERENCES='PROJECT.md:HARNESS/HARNESS.md'
HARNESS_ALLOW_ROOT_INSTRUCTION_OVERRIDE='false'

# Project stages: lint,format,typecheck,test,coverage,build,integration,e2e,
# ci-policy,supply-chain,security,deploy. `none` means no required product stage;
# VERIFY_STAGES may still schedule best-effort stages, whose actual failures are
# fatal but missing implementations may skip. Every REQUIRED_STAGE must be
# included. Reuse an existing product stage when it directly proves an
# acceptance criterion; add a stage only for a distinct execution boundary.
# Test Plan and Trace stage IDs must be scheduled here. Internal `sdd-check` and
# `verify` are closure commands, not acceptance-evidence product stages.
HARNESS_REQUIRED_STAGES='lint,test,build'
HARNESS_VERIFY_STAGES='lint,test,build'

# Governance: auto|required|off. Approval=true makes auto require a complete
# active record and is invalid with off. HARNESS/ACTIVE_CHANGE is canonical.
HARNESS_GOVERNANCE_MODE='required'
HARNESS_REQUIRE_PLAN_APPROVAL='true'
HARNESS_ACTIVE_CHANGE_FILE='HARNESS/ACTIVE_CHANGE'
# Projects may narrow this portable uppercase `PREFIX-number` grammar.
HARNESS_CHANGE_ID_PATTERN='[A-Z][A-Z0-9_-]*-[0-9]+'
HARNESS_SPEC_FILE='SPECIFICATION.md'
HARNESS_CHANGELOG_FILE='SPEC_CHANGELOG.md'
HARNESS_PLAN_FILE='DEVELOPMENT_PLAN.md'
HARNESS_TEST_PLAN_FILE='TEST_PLAN.md'
HARNESS_TRACE_FILE='TRACEABILITY.md'

# Canonical decimal in the inclusive range 0..100.
HARNESS_COVERAGE_THRESHOLD='80'
HARNESS_STRICT_REPO_HYGIENE='false'

# Execution and evidence. Timeout is 0 or 1..86400 seconds. Evidence paths must
# remain repository-contained. Bump COMMAND_ID_PREFIX when command semantics
# change; raw command text is not retained by the Harness.
HARNESS_REQUIRED_TOOLS=''
HARNESS_ENVIRONMENT_COMMAND=''
HARNESS_COMMAND_TIMEOUT_SECONDS='0'
HARNESS_WRITE_REPORTS='true'
HARNESS_REPORT_DIR='test-results/harness'
HARNESS_REPORT_FILE=''
HARNESS_COMMAND_ID_PREFIX='project.v1'
HARNESS_REDACT_ENV_VARS=''
HARNESS_REDACT_MIN_BYTES='8'
HARNESS_EVIDENCE_MAX_STRING_BYTES='65536'
HARNESS_EVIDENCE_MAX_REPORT_BYTES='10485760'

# Network policy is declaration-only, not an OS sandbox.
HARNESS_NETWORK_POLICY='declared'
HARNESS_NETWORK_STAGES='integration,e2e,security,deploy,ci-policy,supply-chain,agent-regression,agent-capability'

# Leave blank for conservative automatic detection. Prefer a project-owned
# script for non-trivial checks. Use `skip` only when the stage is not required.
HARNESS_LINT_COMMAND=''
HARNESS_FORMAT_COMMAND=''
HARNESS_TYPECHECK_COMMAND=''
HARNESS_TEST_COMMAND=''
HARNESS_COVERAGE_COMMAND=''
HARNESS_BUILD_COMMAND=''
HARNESS_INTEGRATION_COMMAND=''
HARNESS_E2E_COMMAND=''
HARNESS_SECURITY_COMMAND=''
HARNESS_DEPLOY_COMMAND=''
HARNESS_CI_POLICY_COMMAND=''
HARNESS_SUPPLY_CHAIN_COMMAND=''

# Agent evaluation is optional and separate from project verification. The
# project-owned validator enforces the bundled schema versions, cross-file
# semantics, digests, manifests, and artifact boundaries. All paths are
# repository-relative; no result-directory component may be a symbolic link.
HARNESS_AGENT_EVAL_DIR='HARNESS/evals'
HARNESS_AGENT_CASE_SCHEMA='HARNESS/schemas/agent-eval-case.schema.json'
HARNESS_AGENT_RESULT_SCHEMA='HARNESS/schemas/agent-eval-result.schema.json'
HARNESS_AGENT_CONTRACT_COMMAND=''
HARNESS_AGENT_RESULT_DIR='test-results/harness/agent-results'
HARNESS_AGENT_TRIALS='3'
HARNESS_AGENT_REGRESSION_COMMAND=''
HARNESS_AGENT_CAPABILITY_COMMAND=''

# Required final sentinel. Adopted config is loaded in an isolated shell and is
# rejected unless execution reaches this assignment.
HARNESS_CONFIG_COMPLETE='1.0.0'
