# Project-owned Harness policy for Dell DDAE Metrics Exporter.
# This trusted Bash fragment is executable repository code, not a dotenv file.
# Never store credentials, private endpoints, production data, or personal data here.

HARNESS_PROJECT_NAME='Dell DDAE Metrics Exporter'
HARNESS_REQUIRED_PATHS='AGENTS.md:PROJECT.md:README.md:SPECIFICATION.md:SPEC_CHANGELOG.md:HARNESS/HARNESS.md:HARNESS/config.env'
HARNESS_EXPECTED_BASELINE_VERSION='1.0.0'

# DDAE-1 product work uses strict SDD and digest-bound named approval.
HARNESS_SDD_MODE='required'

# Instruction discovery. Add new source/test/deployment subtrees as they appear.
HARNESS_INSTRUCTION_MAX_BYTES='32768'
HARNESS_INSTRUCTION_FALLBACK_FILENAMES=''
HARNESS_INSTRUCTION_TARGETS='.:cmd/ddae-exporter:internal:integration'
HARNESS_INSTRUCTION_REFERENCES='PROJECT.md:HARNESS/HARNESS.md:CODE_REVIEW.md:PLANS.md'
HARNESS_ALLOW_ROOT_INSTRUCTION_OVERRIDE='false'

# Local deterministic and environment-dependent release stages. Integration and
# E2E return a blocked result until Peter Chu authorizes their environments.
HARNESS_REQUIRED_STAGES='lint,test,coverage,build,integration,e2e,security,ci-policy,supply-chain'
HARNESS_VERIFY_STAGES='lint,test,coverage,build,integration,e2e,security,ci-policy,supply-chain'

HARNESS_GOVERNANCE_MODE='required'
HARNESS_REQUIRE_PLAN_APPROVAL='true'
HARNESS_ACTIVE_CHANGE_FILE='HARNESS/ACTIVE_CHANGE'
HARNESS_CHANGE_ID_PATTERN='DDAE-[0-9]+'
HARNESS_SPEC_FILE='SPECIFICATION.md'
HARNESS_CHANGELOG_FILE='SPEC_CHANGELOG.md'
HARNESS_PLAN_FILE='DEVELOPMENT_PLAN.md'
HARNESS_TEST_PLAN_FILE='TEST_PLAN.md'
HARNESS_TRACE_FILE='TRACEABILITY.md'

HARNESS_COVERAGE_THRESHOLD='80'
HARNESS_STRICT_REPO_HYGIENE='false'

HARNESS_REQUIRED_TOOLS='git,go,rg'
HARNESS_ENVIRONMENT_COMMAND=''
HARNESS_COMMAND_TIMEOUT_SECONDS='0'
HARNESS_WRITE_REPORTS='true'
HARNESS_REPORT_DIR='test-results/harness'
HARNESS_REPORT_FILE=''
HARNESS_COMMAND_ID_PREFIX='ddae-exporter.product.v1'
HARNESS_REDACT_ENV_VARS='DDAE_USERNAME,DDAE_PASSWORD,DDAE_CLIENT_SECRET,KAFKA_SASL_USERNAME,KAFKA_SASL_PASSWORD'
HARNESS_REDACT_MIN_BYTES='8'
HARNESS_EVIDENCE_MAX_STRING_BYTES='65536'
HARNESS_EVIDENCE_MAX_REPORT_BYTES='10485760'

# Only explicitly declared boundary stages may use network access.
HARNESS_NETWORK_POLICY='declared'
HARNESS_NETWORK_STAGES='integration,e2e,security,deploy,ci-policy,supply-chain,agent-regression,agent-capability'

HARNESS_LINT_COMMAND='./scripts/stage-lint.sh'
HARNESS_FORMAT_COMMAND=''
HARNESS_TYPECHECK_COMMAND=''
HARNESS_TEST_COMMAND='./scripts/stage-test.sh'
HARNESS_COVERAGE_COMMAND='./scripts/stage-coverage.sh'
HARNESS_BUILD_COMMAND='./scripts/build.sh'
HARNESS_INTEGRATION_COMMAND='./scripts/stage-integration.sh'
HARNESS_E2E_COMMAND='./scripts/stage-e2e.sh'
HARNESS_SECURITY_COMMAND='./scripts/security-policy.sh'
HARNESS_DEPLOY_COMMAND=''
HARNESS_CI_POLICY_COMMAND='./scripts/stage-ci-policy.sh'
HARNESS_SUPPLY_CHAIN_COMMAND='./scripts/supply-chain.sh'

# Agent evaluation is not enabled for this project.
HARNESS_AGENT_EVAL_DIR='HARNESS/evals'
HARNESS_AGENT_CASE_SCHEMA='HARNESS/schemas/agent-eval-case.schema.json'
HARNESS_AGENT_RESULT_SCHEMA='HARNESS/schemas/agent-eval-result.schema.json'
HARNESS_AGENT_CONTRACT_COMMAND=''
HARNESS_AGENT_RESULT_DIR='test-results/harness/agent-results'
HARNESS_AGENT_TRIALS='3'
HARNESS_AGENT_REGRESSION_COMMAND=''
HARNESS_AGENT_CAPABILITY_COMMAND=''

HARNESS_CONFIG_COMPLETE='1.0.0'
